<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo><!-- setting GenerateAssemblyInfo to false causes this bug https://github.com/dotnet/project-system/issues/3934 -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Palsa.Api</AssemblyName>
    <PackageId>Palsa.Api</PackageId>
    <OutputType>Library</OutputType>
    <Authors>Kuzikode Intelligent Technologies</Authors>
    <Company>Kuzikode Intelligent Technologies</Company>
    <AssemblyTitle>OpenAPI Library</AssemblyTitle>
    <Description>Official Palsa client, generated from the OpenAPI specification. SMS, email and push from one request.</Description>
    <Copyright>No Copyright</Copyright>
    <RootNamespace>Palsa.Api</RootNamespace>
    <Version>0.3.0</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\Palsa.Api.xml</DocumentationFile>
    <RepositoryUrl>https://github.com/mhodieknowledge/palsa-sdks.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Minor update</PackageReleaseNotes>
    <Nullable>annotations</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <PackageProjectUrl>https://palsa.co.zw/docs</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>palsa;sms;email;push;notifications</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSubTypes" Version="2.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Polly" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
