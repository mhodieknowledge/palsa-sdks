{
  "name": "@palsa/sdk",
  "version": "0.2.0",
  "description": "Official Palsa client, generated from the OpenAPI specification. SMS, email and push from one request.",
  "author": "Kuzikode Intelligent Technologies",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhodieknowledge/palsa-sdks.git",
    "directory": "clients/typescript"
  },
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^4.0 || ^5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "homepage": "https://palsa.co.zw/docs",
  "bugs": {
    "url": "https://github.com/mhodieknowledge/palsa-sdks/issues"
  },
  "keywords": [
    "palsa",
    "sms",
    "email",
    "push",
    "notifications",
    "zimbabwe"
  ]
}
