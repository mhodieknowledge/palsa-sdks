{
  "name": "mhodieknowledge/palsa",
  "version": "0.3.0",
  "description": "Official Palsa client, generated from the OpenAPI specification. SMS, email and push from one request.",
  "keywords": [
    "openapitools",
    "openapi-generator",
    "openapi",
    "php",
    "sdk",
    "rest",
    "api"
  ],
  "homepage": "https://palsa.co.zw/docs",
  "license": "MIT",
  "authors": [
    {
      "name": "Kuzikode Intelligent Technologies",
      "homepage": "https://palsa.co.zw/docs"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^1.7 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.0 || ^9.0",
    "friendsofphp/php-cs-fixer": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "Palsa\\Api\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Palsa\\Api\\Test\\": "test/"
    }
  }
}
